# --- Personal / never tracked ---
# Any folder named "untracked", at any depth (a pattern without a leading "/"
# matches at every level).
untracked/
notes/tmp/

# --- Python ---
__pycache__/
*.py[cod]
*.so

# --- Virtual environments ---
.venv/
venv/
env/
# NOTE: .python-version is intentionally TRACKED (pins the interpreter).

# --- Packaging ---
*.egg-info/
dist/
build/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Secrets ---
.env
.env.*

# --- OS / editors ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log
